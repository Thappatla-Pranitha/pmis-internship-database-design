
Table interns {
  intern_id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(150) [unique, not null]
  college varchar(150)
  graduation_year int
}

Table programs {
  program_id int [pk, increment]
  program_name varchar(100) [not null]
  duration_months int [not null]
}

Table enrollments {
  enrollment_id int [pk, increment]
  intern_id int [not null]
  program_id int [not null]
  start_date date [not null]
  status varchar(30) [not null, default: 'Active']

  indexes {
    (intern_id, program_id) [unique]
  }
}

Table assessments {
  assessment_id int [pk, increment]
  program_id int [not null]
  assessment_name varchar(100) [not null]
  max_marks decimal(5,2) [not null]
}

Table assessment_results {
  result_id int [pk, increment]
  enrollment_id int [not null]
  assessment_id int [not null]
  marks_obtained decimal(5,2)
  result_status varchar(20) [not null, default: 'Pending']

  indexes {
    (enrollment_id, assessment_id) [unique]
  }
}

Ref: interns.intern_id < enrollments.intern_id
Ref: programs.program_id < enrollments.program_id
Ref: programs.program_id < assessments.program_id
Ref: enrollments.enrollment_id < assessment_results.enrollment_id
Ref: assessments.assessment_id < assessment_results.assessment_id

